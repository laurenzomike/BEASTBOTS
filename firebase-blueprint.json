{
  "entities": {
    "Bot": {
      "title": "Bot Configuration",
      "description": "Configuration and status for an individual bot",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string", "enum": ["shopify", "etsy", "pinterest", "kalshi", "polymarket", "botboss", "amazon", "youtube", "alpaca", "coinbase"] },
        "status": { "type": "string", "enum": ["online", "offline", "error", "auth-required"] },
        "autonomous": { "type": "boolean" },
        "config": { "type": "object", "description": "JSON object holding public config for the bot" },
        "createdAt": { "type": "string", "format": "timestamp" },
        "updatedAt": { "type": "string", "format": "timestamp" }
      },
      "required": ["userId", "name", "type", "status", "createdAt", "updatedAt"]
    },
    "Activity": {
      "title": "Bot Activity Log",
      "description": "A single logged event representing an action taken by an autonomous bot.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "botId": { "type": "string" },
        "botType": { "type": "string" },
        "text": { "type": "string" },
        "timestamp": { "type": "string", "format": "timestamp" }
      },
      "required": ["userId", "botId", "botType", "text", "timestamp"]
    },
    "AlpacaConfig": {
      "title": "Alpaca Trading Configuration",
      "description": "Specific credentials and parameters for Alpaca trading.",
      "type": "object",
      "properties": {
        "apiKey": { "type": "string" },
        "apiSecret": { "type": "string" },
        "paperTrading": { "type": "boolean" },
        "maxPositionSize": { "type": "number" },
        "stopLoss": { "type": "number" },
        "takeProfit": { "type": "number" }
      }
    },
    "CoinbaseConfig": {
      "title": "Coinbase Trading Configuration",
      "description": "Specific credentials and parameters for Coinbase Advanced Trade.",
      "type": "object",
      "properties": {
        "apiKey": { "type": "string" },
        "apiSecret": { "type": "string" },
        "tradingPair": { "type": "string" },
        "autoStake": { "type": "boolean" }
      }
    },
    "KalshiConfig": {
      "title": "Kalshi Trading Configuration",
      "description": "Credentials and prediction parameters for Kalshi event markets.",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "password": { "type": "string" },
        "maxContractsPerTrade": { "type": "number" },
        "minProbabilityEdge": { "type": "number" }
      }
    },
    "PolymarketConfig": {
      "title": "Polymarket Trading Configuration",
      "description": "Web3 wallet and order parameters for Polymarket.",
      "type": "object",
      "properties": {
        "proxyWalletAddress": { "type": "string" },
        "apiKey": { "type": "string" },
        "slippageTolerance": { "type": "number" }
      }
    }
  },
  "firestore": {
    "/users/{userId}/bots/{botId}": {
      "schema": "Bot",
      "description": "Stores user bot configurations"
    },
    "/users/{userId}/activities/{activityId}": {
      "schema": "Activity",
      "description": "Stores global real-time activity log events generated by autonomous bots."
    }
  }
}
